def reverse_complement(dna):

    resultat = ""

    for bas in dna[::-1]:

        if bas == "A":
            resultat += "T"

        elif bas == "T":
            resultat += "A"

        elif bas == "C":
            resultat += "G"

        elif bas == "G":
            resultat += "C"

    return resultat


dna = "ATCG"

print("Original:", dna)
print("Reverse complement:", reverse_complement(dna))
